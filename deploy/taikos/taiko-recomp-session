#!/usr/bin/env bash
# Runs directly on KMS in the shipping service; it can still run as Cage's one
# Wayland client for compositor A/B tests.
set -Eeuo pipefail

: "${TAIKOS_OUTPUT:=HDMI-A-1}"
: "${TAIKOS_OUTPUT_MODE:=1920x1080@60Hz}"

# Only meaningful under a Wayland compositor. On the KMSDRM path SDL owns the
# connector itself and wlr-randr is neither present nor wanted.
if [[ -n "${WAYLAND_DISPLAY:-}" && -n "${TAIKOS_OUTPUT}" && -n "${TAIKOS_OUTPUT_MODE}" ]]; then
    # Keep asking for the appliance mode until the output reports it, for up to
    # 30 s. Two things need that patience: a display still waking up has no EDID
    # yet, so the first request simply fails, and Cage can adopt the first
    # client's 1280x720 surface size when SDL creates it. Never fall back to
    # `--on` alone -- that lights the connector at its preferred mode, which on
    # a 4K monitor is 3840x2160@30: four times the pixels for both the game's
    # presentation blit and Cage's composite, at half the refresh rate.
    (
        want="${TAIKOS_OUTPUT_MODE%%@*}"
        for _ in $(seq 30); do
            if wlr-randr 2>/dev/null |
                   grep -qE "^ +${want} px.*current"; then
                sleep 1
                continue
            fi
            wlr-randr --output "${TAIKOS_OUTPUT}" --on \
                --mode "${TAIKOS_OUTPUT_MODE}" 2>/dev/null || true
            sleep 1
        done
    ) &
fi

# The game's stderr does not reach the journal through Cage. Point TAIKOS_LOG
# at a file when diagnosing; unset it for normal appliance operation.
if [[ -n "${TAIKOS_LOG:-}" ]]; then
    exec >>"${TAIKOS_LOG}" 2>&1
fi

exec /var/lib/taikos/recomp/taiko_boot \
    /var/lib/taikos/recomp/EBOOT.elf
