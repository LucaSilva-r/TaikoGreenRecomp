     "        /* Probe: guest libc qsort. The logo screen's two quads tie on depth",
     "         * (both z=1000), so whatever orders equal-key nodes decides which one",
     "         * is submitted last -- and we submit them opposite to real hardware.",
     "         * Log base/count/size/comparator, stamped with the draw sequence, only",
     "         * while the RTT trace is armed. */",
     "        {",
     "            if (rsx_dbg_trace_armed())",
     "                fprintf(stderr,",
     "                        \"[QSORT] base=%08llX n=%llu size=%llu cmp=%08llX seq=%u\\n\",",
     "                        (unsigned long long)ctx->gpr[3],",
     "                        (unsigned long long)ctx->gpr[4],",
     "                        (unsigned long long)ctx->gpr[5],",
     "                        (unsigned long long)ctx->gpr[6],",
     "                        rsx_dbg_draw_seq());",
     "        }"
    ]
   }
