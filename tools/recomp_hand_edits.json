{
 "preamble": [
  "#include <mutex>",
  "",
  "/* The PS3 Dinkumware allocator is protected by guest synchronization that the",
  " * recomp does not yet model reliably across its preemptive host threads.  Keep",
  " * its exported operations atomic while allowing allocator-internal recursion. */",
  "static std::recursive_mutex g_taiko_guest_heap_mutex;",
  "",
  "/* The XML tokenizer keeps its current token and scratch buffers in the",
  " * process-wide object at TOC-0x7284.  The game normally serializes access via",
  " * lightweight synchronization; until that path is fully faithful, concurrent",
  " * song/config loads can overwrite the active token and trip the parser's",
  " * fatal token-state check.  Serialize a complete tokenizer invocation. */",
  "extern \"C\" int rsx_dbg_trace_armed(void);",
  "extern \"C\" uint32_t rsx_dbg_draw_seq(void);",
  "extern \"C\" void (*g_spurs_job_submit)(uint32_t job);",
  "static std::recursive_mutex g_taiko_xml_tokenizer_mutex;",
  "",
  "/* The small-object allocator at 0x005c0f34 maintains a process-wide fallback",
  " * pool (TOC-0x6b70) and allocation bookkeeping (TOC-0x6b68).  Protecting only",
  " * the underlying mspace calls is insufficient: two recompiled host threads can",
  " * race the pool bitmap/refcounts around those calls and later hand mspace a",
  " * corrupted chunk.  Keep the complete allocator/bookkeeping operations atomic.",
  " * Recursive locking is required because allocate/release call the lazy global",
  " * accessor at 0x005c159c. */",
  "static std::recursive_mutex g_taiko_small_object_mutex;",
  ""
 ],
