+/* Narrow native interop used by TaikoRecomp's direct-KMS path. The returned
+ * fd is a new dma-buf descriptor owned by the caller. Only textures created
+ * with SDL.gpu.texture.create.vulkan.dmabuf are accepted. */
+SDL_DECLSPEC bool SDLCALL SDL_GPUVulkanExportTextureDMABUF(
+    SDL_GPUDevice *device,
+    SDL_GPUTexture *gpuTexture,
+    int *fd,
+    Uint32 *pitch,
+    Uint64 *offset,
+    Uint64 *modifier)
+{
+    if (!device || !gpuTexture || !fd || !pitch || !offset || !modifier ||
+        !device->backend || SDL_strcmp(device->backend, "vulkan") != 0) {
+        return SDL_InvalidParamError("Vulkan dma-buf export arguments");
+    }
+    VulkanRenderer *renderer = (VulkanRenderer *)device->driverData;
+    VulkanTextureContainer *container = (VulkanTextureContainer *)gpuTexture;
+    VulkanTexture *texture = container->activeTexture;
+    if (!texture) {
+        return SDL_SetError("GPU texture has no active Vulkan image");
+    }
+    if (!texture->dmaBufExportable) {
+        return SDL_SetError("GPU texture lacks the dma-buf creation marker");
+    }
+    if (!texture->dmaBufMemory) {
+        return SDL_SetError("GPU texture lacks dedicated dma-buf memory");
+    }
+    if (!renderer->vkGetMemoryFdKHR) {
+        return SDL_SetError("vkGetMemoryFdKHR was not loaded");
+    }
+
+    VkMemoryGetFdInfoKHR fdInfo;
+    SDL_zero(fdInfo);
+    fdInfo.sType = VK_STRUCTURE_TYPE_MEMORY_GET_FD_INFO_KHR;
+    fdInfo.memory = texture->dmaBufMemory;
+    fdInfo.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT;
+    VkResult result = renderer->vkGetMemoryFdKHR(
+        renderer->logicalDevice, &fdInfo, fd);
+    if (result != VK_SUCCESS) {
+        return SDL_SetError("vkGetMemoryFdKHR failed: %d", result);
+    }
+
+    VkImageSubresource subresource;
+    SDL_zero(subresource);
+    subresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    VkSubresourceLayout layout;
+    renderer->vkGetImageSubresourceLayout(
+        renderer->logicalDevice, texture->image, &subresource, &layout);
+    if (layout.rowPitch > UINT32_MAX) {
+        close(*fd);
+        *fd = -1;
+        return SDL_SetError("dma-buf row pitch exceeds 32 bits");
+    }
+    *pitch = (Uint32)layout.rowPitch;
+    *offset = (Uint64)layout.offset;
+    *modifier = texture->dmaBufModifier;
+    return true;
+}
