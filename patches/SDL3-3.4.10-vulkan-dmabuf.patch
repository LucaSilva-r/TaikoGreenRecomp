+static Uint32 VULKAN_INTERNAL_IntersectDMABufModifiers(
+    VulkanRenderer *renderer,
+    VkFormat format,
+    VkImageUsageFlags usage,
+    const Uint64 *scanoutModifiers,
+    Uint32 scanoutModifierCount,
+    Uint64 **compatibleModifiers)
+{
+    *compatibleModifiers = NULL;
+    if (!renderer->vkGetPhysicalDeviceFormatProperties2 ||
+        !scanoutModifiers || scanoutModifierCount == 0)
+        return 0;
+
+    VkDrmFormatModifierPropertiesListEXT list;
+    SDL_zero(list);
+    list.sType = VK_STRUCTURE_TYPE_DRM_FORMAT_MODIFIER_PROPERTIES_LIST_EXT;
+    VkFormatProperties2 properties;
+    SDL_zero(properties);
+    properties.sType = VK_STRUCTURE_TYPE_FORMAT_PROPERTIES_2;
+    properties.pNext = &list;
+    renderer->vkGetPhysicalDeviceFormatProperties2(
+        renderer->physicalDevice, format, &properties);
+    if (list.drmFormatModifierCount == 0) return 0;
+
+    VkDrmFormatModifierPropertiesEXT *available = SDL_calloc(
+        list.drmFormatModifierCount,
+        sizeof(VkDrmFormatModifierPropertiesEXT));
+    if (!available) return 0;
+    list.pDrmFormatModifierProperties = available;
+    renderer->vkGetPhysicalDeviceFormatProperties2(
+        renderer->physicalDevice, format, &properties);
+
+    VkFormatFeatureFlags required = 0;
+    if (usage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT)
+        required |= VK_FORMAT_FEATURE_TRANSFER_SRC_BIT;
+    if (usage & VK_IMAGE_USAGE_TRANSFER_DST_BIT)
+        required |= VK_FORMAT_FEATURE_TRANSFER_DST_BIT;
+    if (usage & VK_IMAGE_USAGE_SAMPLED_BIT)
+        required |= VK_FORMAT_FEATURE_SAMPLED_IMAGE_BIT;
+    if (usage & VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT)
+        required |= VK_FORMAT_FEATURE_COLOR_ATTACHMENT_BIT;
+    if (usage & VK_IMAGE_USAGE_STORAGE_BIT)
+        required |= VK_FORMAT_FEATURE_STORAGE_IMAGE_BIT;
+
+    Uint64 *result = SDL_malloc(scanoutModifierCount * sizeof(Uint64));
+    if (!result) {
+        SDL_free(available);
+        return 0;
+    }
+    Uint32 resultCount = 0;
+    for (Uint32 wanted = 0; wanted < scanoutModifierCount; ++wanted) {
+        for (Uint32 have = 0; have < list.drmFormatModifierCount; ++have) {
+            const VkDrmFormatModifierPropertiesEXT *candidate =
+                &available[have];
+            if (candidate->drmFormatModifier == scanoutModifiers[wanted] &&
+                candidate->drmFormatModifierPlaneCount == 1 &&
+                (candidate->drmFormatModifierTilingFeatures & required) ==
+                    required) {
+                result[resultCount++] = scanoutModifiers[wanted];
+                break;
+            }
+        }
+    }
+    SDL_free(available);
+    if (resultCount == 0) {
+        SDL_free(result);
+        return 0;
+    }
+    *compatibleModifiers = result;
+    return resultCount;
+}
